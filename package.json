{
  "name": "biomedical-hydrogen-evidence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Open, structured and verifiable evidence for biomedical research on molecular hydrogen (H2).",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply biomedical-hydrogen-evidence --local",
    "db:seed:local": "wrangler d1 execute biomedical-hydrogen-evidence --local --file=fixtures/synthetic.sql",
    "db:plans:local": "wrangler d1 execute biomedical-hydrogen-evidence --local --file=scripts/query-plans.sql",
    "discovery:collect": "node scripts/discovery/collect.mjs",
    "extraction:plan": "node scripts/extraction/plan.mjs",
    "extraction:run": "node scripts/extraction/run.mjs",
    "extraction:dry-run": "node scripts/extraction/dry-run.mjs",
    "review:candidates": "node scripts/review/candidates.mjs",
    "review:fields": "node scripts/review/fields.mjs",
    "review:journal-metrics:remote": "node scripts/review/refresh-journal-metrics.mjs",
    "check:worker-boundary": "wrangler deploy --dry-run --outdir=.generated/worker-bundle && node scripts/check-worker-boundary.mjs",
    "test": "node --test",
    "lint": "node scripts/check-syntax.mjs",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": ">=20"
  }
}
