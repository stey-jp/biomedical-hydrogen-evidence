{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "biomedical-hydrogen-evidence",
  "main": "src/index.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/mcp", "/healthz"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biomedical-hydrogen-evidence",
      // Replace this placeholder after `npx wrangler d1 create biomedical-hydrogen-evidence`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
