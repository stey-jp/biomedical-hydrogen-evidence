{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "biomedical-hydrogen-evidence",
  "main": "src/index.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/mcp",
      "/healthz",
      "/",
      "/index.html",
      "/study",
      "/study.html",
      "/authors",
      "/authors.html",
      "/author",
      "/author.html",
      "/review",
      "/review/",
      "/review.html"
    ]
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "biomedical-hydrogen-evidence",
      "database_id": "a40eafd1-2dc5-4c27-a73b-4eb907ae552e",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "REVIEW_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  "observability": {
    "enabled": true
  }
}
